# Template for examples/soccer-football/keystore.properties — a private release-signing key config
# that is gitignored and must NOT be committed. Copy this file to "keystore.properties" (same
# directory) and fill in the real values after generating your own keystore; see the "Building it"
# section of this module's README for the keytool command.
#
# storeFile is resolved relative to this directory (examples/soccer-football/), so a keystore saved
# alongside this file needs no path — just its filename.

storeFile=matchday-release.jks
storePassword=CHANGE_ME
keyAlias=matchday-release
keyPassword=CHANGE_ME
